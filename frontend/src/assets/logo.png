.border-b-danger { border-bottom-color: var(--cds-border-danger); }

.border-b-danger-000 { border-bottom-color: hsl(var(--danger-000) / 1); }

.border-b-danger-100 { border-bottom-color: hsl(var(--danger-100) / 1); }

.border-b-danger-200 { border-bottom-color: hsl(var(--danger-200) / 1); }

.border-b-danger-900 { border-bottom-color: hsl(var(--danger-900) / 1); }

.border-b-destructive { border-bottom-color: hsl(var(--destructive)); }

.border-b-destructive-foreground, .border-b-destructive-foreground\/0 { bor=
der-bottom-color: hsl(var(--destructive-foreground)); }

@supports (color:color-mix(in lab, red, red)) {
  .border-b-destructive-foreground\/0 { border-bottom-color: color-mix(in o=
klab, hsl(var(--destructive-foreground)) 0%, transparent); }
}

.border-b-destructive-foreground\/5 { border-bottom-color: hsl(var(--destru=
ctive-foreground)); }

@supports (color:color-mix(in lab, red, red)) {
  .border-b-destructive-foreground\/5 { border-bottom-color: color-mix(in o=
